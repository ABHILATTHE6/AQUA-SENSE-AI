{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqua-sense-ai.local/schemas/observation.schema.json",
  "title": "AQUA-SENSE Environmental Observation",
  "description": "Initial canonical contract for a time-stamped environmental observation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "observed_at", "location_id", "source", "variable", "value", "unit"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "location_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "variable": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "quality_flag": {"type": "string"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "metadata": {"type": "object"}
  }
}
